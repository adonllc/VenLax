# ── Database (Railway) ────────────────────────────────────────────────────────
# Use the INTERNAL URL when deployed on Railway, PUBLIC URL for local testing
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres.railway.internal:5432/railway

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:CHANGE_ME@your-instance.upstash.io:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRO_PRICE_ID=price_CHANGE_ME
STRIPE_ELITE_PRICE_ID=price_CHANGE_ME

# ── AI / External APIs ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
HF_API_KEY=hf_CHANGE_ME
NEWSAPI_KEY=CHANGE_ME

# ── Push Notifications ────────────────────────────────────────────────────────
# iOS APNs
APNS_KEY_PATH=/run/secrets/apns.p8
APNS_KEY_ID=CHANGE_ME
APNS_TEAM_ID=CHANGE_ME
APNS_BUNDLE_ID=com.venlaxiq

# Android FCM
FCM_PROJECT_ID=CHANGE_ME
FCM_CLIENT_EMAIL=firebase-adminsdk@CHANGE_ME.iam.gserviceaccount.com
FCM_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nCHANGE_ME\n-----END RSA PRIVATE KEY-----

# ── File Storage (Cloudflare R2 or MinIO) ────────────────────────────────────
# For Cloudflare R2: endpoint is https://<account-id>.r2.cloudflarestorage.com
MINIO_ENDPOINT=CHANGE_ME
MINIO_PORT=443
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=venlaxiq-receipts
MINIO_USE_SSL=true

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
# Internal URL from web service to api service in Coolify Docker network
# Format: http://<api-service-name>:<port> — use the service name you gave the API in Coolify
API_URL=http://gtem3md7vam02lj9nwug8fr7:3001
