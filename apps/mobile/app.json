{
  "expo": {
    "name": "VenlaxIQ",
    "slug": "venlaxiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "venlaxiq",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.venlaxiq"
    },
    "android": {
      "adaptiveIcon": {},
      "package": "com.venlaxiq"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00D46A"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#00D46A"
    }
  }
}
